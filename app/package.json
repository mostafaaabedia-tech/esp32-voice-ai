{
  "name": "voiceai-app",
  "version": "2.0.0",
  "private": true,
  "description": "VoiceAI phone app: chat + voice for the ESP32 local AI speaker",
  "scripts": {
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "android:add": "npx cap add android && node scripts/patch-android.js",
    "sync": "npx cap sync android",
    "apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  }
}
